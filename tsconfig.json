{
  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2023"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
